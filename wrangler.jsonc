{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vllora-backoffice",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "triggers": { "crons": ["15 2 * * *"] },
  "vars": {
    "ENVIRONMENT": "production",
    "APP_ORIGIN": "https://portal.example.com",
    "MASTER_API_BASE": "https://portal.example.com",
    "EXTRA_ORIGINS": "",
    "MEDIA_PUBLIC_BASE": "",
    "AE_DATASET": "vllora_metrics",
    "BUSINESS_AE_DATASET": "vllora_business_events",
    "WORKER_SCRIPT_NAME": "vllora-backoffice"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "vllora_backoffice", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "worker/migrations" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "vllora-media" }],
  // Optional: add the BRAND_CACHE namespace binding after provisioning it.
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "vllora_metrics" },
    { "binding": "BUSINESS_ANALYTICS", "dataset": "vllora_business_events" }
  ]
  // Add the platform's Cloudflare custom domain/route before deployment.
}
