{
  "name": "vllora-backoffice",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.dev.jsonc",
    "build": "npm run build:portal && npm run build:master",
    "preview": "vite preview",
    "dev:api": "wrangler dev --config wrangler.dev.jsonc",
    "dev:ui": "vite --host 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit && tsc -p worker/tsconfig.json",
    "db:init": "wrangler d1 migrations apply vllora_backoffice --remote",
    "db:local": "wrangler d1 migrations apply vllora_backoffice --config wrangler.dev.jsonc --local",
    "deploy": "npm run build && wrangler deploy",
    "test": "npm run build && node --test scripts/integration.test.mjs scripts/cloudflare.test.mjs scripts/split-build.test.mjs",
    "test:ui": "npm run build && node --test scripts/browser.test.mjs",
    "build:master": "node scripts/build-master.mjs",
    "build:portal": "vite build"
  },
  "dependencies": {
    "@fontsource-variable/cinzel": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@jsquash/webp": "1.5.0",
    "@noble/hashes": "2.0.1",
    "chart.js": "4.4.7",
    "hono": "^4.13.19",
    "lucide-react": "^1.76.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "@sparticuz/chromium": "^153.0.0",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "esbuild": "^0.28.2",
    "miniflare": "5.20261119.0-beta",
    "playwright": "^1.65.1",
    "tailwind-legacy": "npm:tailwindcss@3.4.17",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "wrangler": "^4.166.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
